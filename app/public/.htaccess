# handle errors custom page
ErrorDocument 404 /error/404.php

# disable directory browsing, follow symbolic links
Options All -Indexes +FollowSymlinks

# default handler
DirectoryIndex index.php index.html index.htm

# rewrite 
RewriteEngine on

# Force HTTPS, unless explicitly disabled via the FORCE_HTTPS env var
# (see docker-compose.yml / apache2.conf). FORCE_HTTPS unset or "true" keeps
# the original behaviour of always redirecting to HTTPS.
RewriteCond %{ENV:FORCE_HTTPS} !=false
RewriteCond %{HTTPS} off

# Strip any non-standard port so the redirect always targets HTTPS port 443
RewriteCond %{HTTP_HOST} ^([^:]+)(:[0-9]+)?$
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
    
# stop redirecting if the request has already been redirected once
RewriteCond %{ENV:REDIRECT_STATUS} 200
RewriteRule .* - [L]

# rewrite rule handle friendly urls
RewriteRule ^pages/(.*)$ cms/pages.php/$1 [L]
RewriteRule ^view/(.*)$ cms/pages.php/$1 [L]

# handle requests not referring directly to files 
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]
